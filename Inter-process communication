#include <stdio.h>
#include <stdlib.h>
#include <sys/shm.h>
#include <sys/ipc.h>
#include <sys/wait.h>
#include <unistd.h>
#include <string.h>

int main() {
    key_t key = ftok("shmfile", 65);
    int shmid = shmget(key, 1024, 0666 | IPC_CREAT);
    char *str = (char*)shmat(shmid, (void*)0, 0);

    if (fork() == 0) {
        printf("Child: Writing to memory...\n");
        strcpy(str, "Hello from child!");
        shmdt(str);
        exit(0);
    } else {
        wait(NULL);
        printf("Parent: Data read from memory: %s\n", str);
        shmdt(str);
        shmctl(shmid, IPC_RMID, NULL);
    }
    return 0;
}
