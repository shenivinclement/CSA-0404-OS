#include <stdio.h>
#include <stdlib.h>

int main() {
    int n, frames, pageFaults = 0;
    int *pages, *memory;
    int index = 0;

    printf("Enter number of pages: ");
    scanf("%d", &n);

    pages = (int *)malloc(n * sizeof(int));
    printf("Enter page reference string:\n");
    for (int i = 0; i < n; i++)
        scanf("%d", &pages[i]);

    printf("Enter number of frames: ");
    scanf("%d", &frames);

    memory = (int *)malloc(frames * sizeof(int));
    for (int i = 0; i < frames; i++)
        memory[i] = -1;

    for (int i = 0; i < n; i++) {
        int found = 0;
        for (int j = 0; j < frames; j++) {
            if (memory[j] == pages[i]) {
                found = 1;
                break;
            }
        }

        if (!found) {
            memory[index] = pages[i];
            index = (index + 1) % frames;
            pageFaults++;
        }
    }

    printf("Total Page Faults = %d\n", pageFaults);

    free(pages);
    free(memory);
    return 0;
}
