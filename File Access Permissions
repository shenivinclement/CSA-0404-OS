#include <stdio.h>
#include <sys/stat.h>

int main() {
    struct stat st;
    stat("hello.txt", &st);

    printf("PERMISSIONS FOR hello.txt:\n");
    printf("Owner: %s%s%s\n", (st.st_mode & S_IRUSR) ? "r" : "-", 
                              (st.st_mode & S_IWUSR) ? "w" : "-", 
                              (st.st_mode & S_IXUSR) ? "x" : "-");
    printf("Group: %s%s%s\n", (st.st_mode & S_IRGRP) ? "r" : "-", 
                              (st.st_mode & S_IWGRP) ? "w" : "-", 
                              (st.st_mode & S_IXGRP) ? "x" : "-");
    printf("Other: %s%s%s\n", (st.st_mode & S_IROTH) ? "r" : "-", 
                              (st.st_mode & S_IWOTH) ? "w" : "-", 
                              (st.st_mode & S_IXOTH) ? "x" : "-");
    return 0;
}
