#include <stdio.h>
#include <stdlib.h>

int main() {
    int n, tq, *bt, *rem_bt, *wt, *tat, time = 0, completed = 0;
    float awt = 0, atat = 0;

    printf("Enter number of processes: ");
    scanf("%d", &n);
    printf("Enter time quantum: ");
    scanf("%d", &tq);

    bt = (int*)malloc(n * sizeof(int));
    rem_bt = (int*)malloc(n * sizeof(int));
    wt = (int*)calloc(n, sizeof(int));
    tat = (int*)malloc(n * sizeof(int));

    for (int i = 0; i < n; i++) {
        printf("Burst time for P%d: ", i + 1);
        scanf("%d", &bt[i]);
        rem_bt[i] = bt[i];
    }

    while (completed < n) {
        for (int i = 0; i < n; i++) {
            if (rem_bt[i] > 0) {
                if (rem_bt[i] > tq) {
                    time += tq;
                    rem_bt[i] -= tq;
                } else {
                    time += rem_bt[i];
                    wt[i] = time - bt[i];
                    rem_bt[i] = 0;
                    completed++;
                }
            }
        }
    }

    printf("\nProcess\tBT\tWT\tTAT\n");
    for (int i = 0; i < n; i++) {
        tat[i] = bt[i] + wt[i];
        awt += wt[i];
        atat += tat[i];
        printf("P%d\t%d\t%d\t%d\n", i + 1, bt[i], wt[i], tat[i]);
    }

    printf("\nAverage WT: %.2f\nAverage TAT: %.2f\n", awt / n, atat / n);

    free(bt); free(rem_bt); free(wt); free(tat);
    return 0;
}
