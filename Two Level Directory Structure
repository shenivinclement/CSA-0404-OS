#include <stdio.h>
#include <string.h>

struct {
    char dname[10], fname[10][10];
    int fcnt;
} dir[10];

int main() {
    int i, ch, dcnt = 0, k;
    char d[10];
    while(1) {
        printf("\n1. Create Directory  2. Create File  3. List  4. Exit\nChoice: ");
        scanf("%d", &ch);
        switch(ch) {
            case 1: printf("Enter dir name: ");
                    scanf("%s", dir[dcnt++].dname); break;
            case 2: printf("Enter dir name: ");
                    scanf("%s", d);
                    for(i=0; i<dcnt; i++)
                        if(strcmp(d, dir[i].dname) == 0) {
                            printf("Enter file name: ");
                            scanf("%s", dir[i].fname[dir[i].fcnt++]);
                            break;
                        }
                    break;
            case 3: for(i=0; i<dcnt; i++) {
                        printf("\nDir: %s Files: ", dir[i].dname);
                        for(k=0; k<dir[i].fcnt; k++) printf("%s ", dir[i].fname[k]);
                    } break;
            default: return 0;
        }
    }
}
