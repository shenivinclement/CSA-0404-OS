#include <stdio.h>
#include <string.h>

int main() {
    char word[20], line[100];
    FILE *fp = fopen("hello.txt", "r");

    if (fp == NULL) return 0;

    printf("Search for word: ");
    scanf("%s", word);

    while (fgets(line, sizeof(line), fp)) {
        if (strstr(line, word)) { // Sniffing for the word!
            printf("MATCH FOUND: %s", line);
        }
    }
    fclose(fp);
    return 0;
}
