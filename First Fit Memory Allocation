#include <stdio.h>
int main() {
    int b[]={100, 500, 200, 300}, p[]={212, 417, 112}, nb=4, np=3, alloc[3], i, j;
    for(i=0; i<np; i++) {
        alloc[i] = -1;
        for(j=0; j<nb; j++)
            if(b[j] >= p[i]) { alloc[i]=j; b[j]-=p[i]; break; }
    }
    printf("P_Size\tBlock_No\n");
    for(i=0; i<np; i++) printf("%d\t%s\n", p[i], alloc[i]!=-1 ? "Allocated" : "No");
    return 0;
}
