#include <stdio.h>
#include <stdlib.h>

int main() {
    int total_blocks, *disk, start, len;
    printf("Enter total blocks on disk: ");
    scanf("%d", &total_blocks);
    disk = calloc(total_blocks, sizeof(int));

    while (1) {
        printf("Enter start block and length: ");
        scanf("%d %d", &start, &len);

        int can_allocate = 1;
        if (start + len > total_blocks) {
            can_allocate = 0;
        } else {
            for (int i = start; i < start + len; i++) {
                if (disk[i] == 1) {
                    can_allocate = 0;
                    break;
                }
            }
        }

        if (can_allocate) {
            for (int i = start; i < start + len; i++) disk[i] = 1;
            printf("Allocated successfully\n");
        } else {
            printf("Allocation failed\n");
        }

        int cont;
        printf("1 to continue, 0 to exit: ");
        scanf("%d", &cont);
        if (!cont) break;
    }

    free(disk);
    return 0;
}
