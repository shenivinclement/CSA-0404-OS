#include <stdio.h>
#include <stdlib.h>

int main() {
    int files;
    int *start, *length;

    printf("Enter number of files: ");
    scanf("%d", &files);

    start = (int *)malloc(files * sizeof(int));
    length = (int *)malloc(files * sizeof(int));

    for (int i = 0; i < files; i++) {
        printf("Enter start block and length of file %d: ", i + 1);
        scanf("%d %d", &start[i], &length[i]);
    }

    printf("\nFile No\tStart Block\tLength\tBlocks Allocated\n");
    for (int i = 0; i < files; i++) {
        printf("%d\t%d\t\t%d\t", i + 1, start[i], length[i]);
        for (int j = 0; j < length[i]; j++)
            printf("%d ", start[i] + j);
        printf("\n");
    }

    free(start);
    free(length);
    return 0;
}

