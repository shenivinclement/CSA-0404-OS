#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <stdlib.h>

int main() {
    char source[100], dest[100], buffer[1024];
    int fd_src, fd_dest;
    ssize_t n_read;

    printf("Enter source file name: ");
    scanf("%s", source);
    printf("Enter destination file name: ");
    scanf("%s", dest);

    fd_src = open(source, O_RDONLY);
    if (fd_src == -1) {
        perror("Error opening source");
        exit(1);
    }

    fd_dest = open(dest, O_WRONLY | O_CREAT | O_TRUNC, 0644);
    if (fd_dest == -1) {
        perror("Error opening destination");
        close(fd_src);
        exit(1);
    }

    while ((n_read = read(fd_src, buffer, sizeof(buffer))) > 0) {
        write(fd_dest, buffer, n_read);
    }

    close(fd_src);
    close(fd_dest);
    printf("File copied successfully.\n");

    return 0;
}
