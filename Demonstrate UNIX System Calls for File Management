#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main() {
    int fd = creat("demo.txt", 0644); // Create
    write(fd, "Hello UNIX", 10);      // Write
    close(fd);                        // Close

    fd = open("demo.txt", O_RDONLY);  // Open
    char buf[11];
    read(fd, buf, 10);                // Read
    buf[10] = '\0';
    printf("File Content: %s\n", buf);
    close(fd);
    return 0;
}
